# Production counterpart of proxy.conf.mjs: the browser only talks to this origin and nginx forwards
# /api to the API, so the API needs no CORS. API_URL is substituted at container startup.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_URL};
        # Container Apps ingress routes by Host and SNI, so both must be the API's host, not ours
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # nginx itself receives plain HTTP from the ingress: pass on the scheme the browser really used
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # After idling, the API scales from zero and the serverless database resumes (up to ~1 min):
        # the default 60 s would turn that cold start into a 504
        proxy_read_timeout 120s;
        # Invoice uploads: nginx's default is 1 MB. The API allows a 10 MB file plus the multipart envelope and
        # answers anything in between with a clear 400; past this, nginx cuts it off with a 413
        client_max_body_size 11m;
    }

    # Hashed bundles (main-ABC123.js) never change: cache them for a year
    location ~* \.(?:js|css|woff2?|png|svg|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths are Angular routes. index.html is never cached so new deploys are picked up.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
