<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Plumy.Application\Plumy.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Messaging.ServiceBus" Version="13.6.4" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.6.4" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.4" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Stripe.net" Version="53.1.0" />
    <!-- Pin: Aspire 13.6.1 pulls 10.0.12, vulnerable to CVE-2026-84008 and CVE-2026-70162. Remove once Aspire ships with >= 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Pin: Aspire 13.6.1 pulls EF Core 10.0.12, while EF Design in the Api brings 10.0.13; keep every project on one version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Repositories are internal (only DI hands them out); their queries are tested against a real SQL Server -->
    <InternalsVisibleTo Include="Plumy.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
